<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.me.mybatis_demo.mapper.ArticleInfoMapperXML">

    <select id="selectById" resultType="org.me.mybatis_demo.model.ArticleInfo">
        SELECT *
        FROM articleinfo ai
        LEFT JOIN user_info ui ON ai.uid = ui.id
        WHERE ai.id = #{id}
    </select>
</mapper>